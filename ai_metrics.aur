// ai_metrics.aur — Aurora 评估指标
// 对标 sklearn.metrics

mod ai_metrics;

// ============ 分类指标 ============

// 准确率
pub fn accuracy(preds: List<int>, targets: List<int>) -> f64 {
    let mut correct = 0;
    let n = list_len(preds);
    for i in range(n) {
        if list_get(preds, i) == list_get(targets, i) {
            correct = correct + 1;
        }
    }
    return float(correct) / float(n);
}

// 精确率（单类）
pub fn precision(preds: List<int>, targets: List<int>, positive: int) -> f64 {
    let mut tp = 0;
    let mut fp = 0;
    for i in range(list_len(preds)) {
        let p = list_get(preds, i);
        let t = list_get(targets, i);
        if p == positive && t == positive { tp = tp + 1; }
        else if p == positive && t != positive { fp = fp + 1; }
    }
    if tp + fp == 0 { return 0.0; }
    return float(tp) / float(tp + fp);
}

// 召回率（单类）
pub fn recall(preds: List<int>, targets: List<int>, positive: int) -> f64 {
    let mut tp = 0;
    let mut fn_ = 0;
    for i in range(list_len(preds)) {
        let p = list_get(preds, i);
        let t = list_get(targets, i);
        if p == positive && t == positive { tp = tp + 1; }
        else if p != positive && t == positive { fn_ = fn_ + 1; }
    }
    if tp + fn_ == 0 { return 0.0; }
    return float(tp) / float(tp + fn_);
}

// F1 分数
pub fn f1_score(preds: List<int>, targets: List<int>, positive: int) -> f64 {
    let p = precision(preds, targets, positive);
    let r = recall(preds, targets, positive);
    if p + r == 0 { return 0.0; }
    return 2.0 * p * r / (p + r);
}

// 混淆矩阵
pub fn confusion_matrix(preds: List<int>, targets: List<int>, num_classes: int) -> List<List<int>> {
    let mut matrix = list_new();
    for i in range(num_classes) {
        let mut row = list_new();
        for j in range(num_classes) {
            list_push(row, 0);
        }
        list_push(matrix, row);
    }
    for i in range(list_len(preds)) {
        let p = list_get(preds, i);
        let t = list_get(targets, i);
        list_set(list_get(matrix, t), p, list_get(list_get(matrix, t), p) + 1);
    }
    return matrix;
}

// ============ 回归指标 ============

// MSE
pub fn mse(preds: List<f64>, targets: List<f64>) -> f64 {
    let n = list_len(preds);
    let mut sum = 0.0;
    for i in range(n) {
        let diff = list_get(preds, i) - list_get(targets, i);
        sum = sum + diff * diff;
    }
    return sum / float(n);
}

// RMSE
pub fn rmse(preds: List<f64>, targets: List<f64>) -> f64 {
    return sqrt(mse(preds, targets));
}

// MAE
pub fn mae(preds: List<f64>, targets: List<f64>) -> f64 {
    let n = list_len(preds);
    let mut sum = 0.0;
    for i in range(n) {
        sum = sum + abs(list_get(preds, i) - list_get(targets, i));
    }
    return sum / float(n);
}

// R² 分数
pub fn r2_score(preds: List<f64>, targets: List<f64>) -> f64 {
    let n = list_len(targets);
    let mut mean = 0.0;
    for i in range(n) { mean = mean + list_get(targets, i); }
    mean = mean / float(n);

    let mut ss_tot = 0.0;
    let mut ss_res = 0.0;
    for i in range(n) {
        let diff_tot = list_get(targets, i) - mean;
        ss_tot = ss_tot + diff_tot * diff_tot;
        let diff_res = list_get(targets, i) - list_get(preds, i);
        ss_res = ss_res + diff_res * diff_res;
    }
    if ss_tot == 0.0 { return 0.0; }
    return 1.0 - ss_res / ss_tot;
}

// ============ 多类指标 ============

// 宏平均精确率
pub fn macro_precision(preds: List<int>, targets: List<int>, num_classes: int) -> f64 {
    let mut sum = 0.0;
    for c in range(num_classes) {
        sum = sum + precision(preds, targets, c);
    }
    return sum / float(num_classes);
}

// 宏平均召回率
pub fn macro_recall(preds: List<int>, targets: List<int>, num_classes: int) -> f64 {
    let mut sum = 0.0;
    for c in range(num_classes) {
        sum = sum + recall(preds, targets, c);
    }
    return sum / float(num_classes);
}

// 宏平均 F1
pub fn macro_f1(preds: List<int>, targets: List<int>, num_classes: int) -> f64 {
    let mut sum = 0.0;
    for c in range(num_classes) {
        sum = sum + f1_score(preds, targets, c);
    }
    return sum / float(num_classes);
}

// ============ 分类报告 ============
pub struct ClassificationReport {
    precision: f64,
    recall: f64,
    f1: f64,
    support: int,
}

pub fn classification_report(preds: List<int>, targets: List<int>, num_classes: int) -> List<ClassificationReport> {
    let mut reports = list_new();
    for c in range(num_classes) {
        let p = precision(preds, targets, c);
        let r = recall(preds, targets, c);
        let f1 = f1_score(preds, targets, c);
        // support: 真实为 c 的样本数
        let mut support = 0;
        for i in range(list_len(targets)) {
            if list_get(targets, i) == c { support = support + 1; }
        }
        list_push(reports, ClassificationReport {
            precision: p,
            recall: r,
            f1: f1,
            support: support,
        });
    }
    return reports;
}
