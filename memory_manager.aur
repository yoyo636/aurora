# memory_manager.aur — Aurora 内存管理器（自举版）
# Arena 分配器 + 简单 GC 标记-清除
# 对应 Python memory_manager.py

import stdlib

# 内存统计
var mem_stats = {
    bytes_allocated: 0,
    bytes_freed: 0,
    blocks_allocated: 0,
    blocks_freed: 0,
    collections: 0
}

# Arena 块大小（64KB）
var ARENA_BLOCK_SIZE = 65536

# 堆块结构
type HeapBlock {
    ptr: int,
    size: int,
    marked: bool,
    next: HeapBlock
}

# 全局堆链表
var heap_head = nil
var heap_tail = nil

# Arena 当前位置
var arena_current = 0
var arena_end = 0

# ============ Arena 分配器 ============
# 快速分配：从 arena bump 指针

pub fn arena_alloc(size) -> int {
    # FFI: sbrk / mmap
    # 如果当前 arena 不够，分配新块
    if arena_current + size > arena_end {
        # 分配新的 arena 块
        var block_size = stdlib.max(ARENA_BLOCK_SIZE, size)
        var ptr = sys_mmap(block_size)
        if ptr == 0 {
            stdlib.println("内存分配失败")
            return 0
        }
        arena_current = ptr
        arena_end = ptr + block_size
    }

    var ptr = arena_current
    arena_current = arena_current + size
    mem_stats.bytes_allocated = mem_stats.bytes_allocated + size
    mem_stats.blocks_allocated = mem_stats.blocks_allocated + 1
    return ptr
}

# Arena 重置（不释放内存，只重置指针）
pub fn arena_reset() {
    arena_current = 0
    arena_end = 0
}

# ============ 堆分配（可释放）============
# 用于需要 GC 的对象

pub fn gc_alloc(size) -> int {
    var ptr = sys_mmap(size)
    if ptr == 0 {
        stdlib.println("GC 分配失败，触发回收")
        gc_collect()
        ptr = sys_mmap(size)
        if ptr == 0 {
            stdlib.println("内存不足")
            return 0
        }
    }

    # 注册到堆链表
    var block = HeapBlock {
        ptr: ptr,
        size: size,
        marked: false,
        next: nil
    }

    if heap_tail == nil {
        heap_head = block
        heap_tail = block
    } else {
        heap_tail.next = block
        heap_tail = block
    }

    mem_stats.bytes_allocated = mem_stats.bytes_allocated + size
    mem_stats.blocks_allocated = mem_stats.blocks_allocated + 1
    return ptr
}

# ============ 标记-清除 GC ============

pub fn gc_collect() {
    mem_stats.collections = mem_stats.collections + 1

    # 阶段 1：标记（从根集合出发）
    gc_mark_roots()

    # 阶段 2：清除
    gc_sweep()
}

# 标记根对象
fn gc_mark_roots() {
    # 标记全局变量、栈上变量、寄存器
    var block = heap_head
    while block != nil {
        # 简化版：标记所有从根可达的对象
        # 实际实现会遍历根集合并跟随指针
        block.marked = false
        block = block.next
    }
}

# 清除未标记对象
fn gc_sweep() {
    var block = heap_head
    var prev = nil
    while block != nil {
        if !block.marked {
            # 释放这个块
            sys_munmap(block.ptr, block.size)
            mem_stats.bytes_freed = mem_stats.bytes_freed + block.size
            mem_stats.blocks_freed = mem_stats.blocks_freed + 1

            # 从链表移除
            if prev == nil {
                heap_head = block.next
            } else {
                prev.next = block.next
            }
            if heap_tail == block {
                heap_tail = prev
            }
        } else {
            block.marked = false
            prev = block
        }
        block = block.next
    }
}

# ============ 栈帧管理 ============

# 函数调用栈帧
type StackFrame {
    fn_name: string,
    locals: {},
    args: {},
    prev_frame: StackFrame
}

var current_frame = nil

pub fn push_frame(fn_name) {
    var frame = StackFrame {
        fn_name: fn_name,
        locals: {},
        args: {},
        prev_frame: current_frame
    }
    current_frame = frame
}

pub fn pop_frame() {
    if current_frame != nil {
        current_frame = current_frame.prev_frame
    }
}

pub fn get_local(name) {
    if current_frame == nil { return nil }
    if has_key(current_frame.locals, name) {
        return current_frame.locals[name]
    }
    # 向上查找
    var frame = current_frame.prev_frame
    while frame != nil {
        if has_key(frame.locals, name) {
            return frame.locals[name]
        }
        frame = frame.prev_frame
    }
    return nil
}

pub fn set_local(name, value) {
    if current_frame != nil {
        current_frame.locals[name] = value
    }
}

# ============ 字符串内存池 ============

# 字符串驻留（interning）：相同字符串只存一份
var string_pool = {}

pub fn intern(s) -> string {
    if has_key(string_pool, s) {
        return string_pool[s]
    }
    string_pool[s] = s
    return s
}

pub fn pool_size() -> int {
    var count = 0
    for k in string_pool {
        count = count + 1
    }
    return count
}

# ============ 统计报告 ============

pub fn stats() {
    stdlib.println("内存统计:")
    stdlib.println("  已分配字节: " + stdlib.str(mem_stats.bytes_allocated))
    stdlib.println("  已释放字节: " + stdlib.str(mem_stats.bytes_freed))
    stdlib.println("  已分配块数: " + stdlib.str(mem_stats.blocks_allocated))
    stdlib.println("  已释放块数: " + stdlib.str(mem_stats.blocks_freed))
    stdlib.println("  GC 次数: " + stdlib.str(mem_stats.collections))
    stdlib.println("  字符串池: " + stdlib.str(pool_size()) + " 条")
}

# ============ FFI 桥接 ============

fn sys_mmap(size) -> int {
    # FFI: mmap(NULL, size, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
    return 0
}

fn sys_munmap(ptr, size) {
    # FFI: munmap(ptr, size)
}

fn has_key(d, key) -> bool {
    var found = false
    for k in d {
        if k == key { found = true }
    }
    return found
}
