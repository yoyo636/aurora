fn replace_all(s, old, new) -> string {
    var result = ""
    var i = 0
    while i < len(s) {
        if i + len(old) <= len(s) {
            var match = true
            var j = 0
            while j < len(old) {
                if char_at(s, i + j) != char_at(old, j) {
                    match = false
                    break
                }
                j = j + 1
            }
            if match {
                result = result + new
                i = i + len(old)
                continue
            }
        }
        result = result + char_at(s, i)
        i = i + 1
    }
    return result
}
