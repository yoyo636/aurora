# refactor_engine.aur — 重构引擎（自举版）
# 对应 Python refactor_engine.py
# 重命名、提取函数、内联、移动符号

import stdlib
import stdlib_fs
import project_index

# 重命名符号
pub fn rename(old_name, new_name) {
    stdlib.println("重命名: " + old_name + " -> " + new_name)

    # 查找所有引用
    var refs = project_index.find_references(old_name)
    var count = 0

    var i = 0
    while i < len(refs) {
        var ref = refs[i]
        var content = stdlib_fs.read_file(ref.file)
        var new_content = replace_all(content, old_name, new_name)
        stdlib_fs.write_file(ref.file, new_content)
        count = count + 1
        i = i + 1
    }

    stdlib.println("✓ 已替换 " + stdlib.str(count) + " 处")
}

