#!/bin/bash
# Aurora IDE —— macOS 应用启动器
# 优先使用项目自带 venv(含 pywebview)→ 内嵌原生窗口;否则回退浏览器模式
APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PROJECT_ROOT="$(cd "$APP_DIR/../.." && pwd)"

PY=""
for c in "$PROJECT_ROOT/ide/.venv/bin/python" /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  if [ -x "$c" ] && "$c" -c "import webview" >/dev/null 2>&1; then
    PY="$c"
    break
  fi
done
if [ -z "$PY" ]; then
  PY="$(command -v python3)"
fi

exec "$PY" "$APP_DIR/MacOS/launcher.py" "$PROJECT_ROOT"
