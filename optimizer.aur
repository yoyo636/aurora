# optimizer.aur — Aurora 优化器（自举版）
# 三阶段：常量折叠 → 死代码消除 → 函数内联
# 对应 Python optimizer.py

import stdlib
import ast

# 优化统计
var opt_stats = {
    const_folded: 0,
    dead_code_removed: 0,
    inlined: 0,
    peephole: 0
}

# 主入口：优化 AST
pub fn optimize(ast_tree) {
    opt_stats.const_folded = 0
    opt_stats.dead_code_removed = 0
    opt_stats.inlined = 0
    opt_stats.peephole = 0

    ast_tree = fold_constants(ast_tree)
    ast_tree = eliminate_dead_code(ast_tree)
    ast_tree = inline_small_functions(ast_tree)
    ast_tree = peephole(ast_tree)

    return ast_tree
}

# ============ 阶段 1：常量折叠 ============
# 把 1 + 2 折叠成 3，把 "a" + "b" 折叠成 "ab"

fn fold_constants(node) {
    if node == nil { return nil }

    if node.tag == "Program" {
        var i = 0
        while i < len(node.stmts) {
            node.stmts[i] = fold_constants(node.stmts[i])
            i = i + 1
        }
        return node
    }

    if node.tag == "FnDef" {
        node.body = fold_constants(node.body)
        return node
    }

    if node.tag == "Block" {
        var i = 0
        while i < len(node.stmts) {
            node.stmts[i] = fold_constants(node.stmts[i])
            i = i + 1
        }
        return node
    }

    if node.tag == "If" {
        node.cond = fold_constants(node.cond)
        node.then_block = fold_constants(node.then_block)
        if node.else_block != nil {
            node.else_block = fold_constants(node.else_block)
        }
        # 常量条件折叠：if true { ... } else { ... }
        if node.cond.tag == "Bool" {
            opt_stats.const_folded = opt_stats.const_folded + 1
            if node.cond.value {
                return node.then_block
            } else {
                return node.else_block
            }
        }
        return node
    }

    if node.tag == "While" {
        node.cond = fold_constants(node.cond)
        node.body = fold_constants(node.body)
        return node
    }

    if node.tag == "Return" {
        if node.value != nil {
            node.value = fold_constants(node.value)
        }
        return node
    }

    if node.tag == "Let" or node.tag == "Var" {
        node.value = fold_constants(node.value)
        return node
    }

    if node.tag == "BinOp" {
        node.left = fold_constants(node.left)
        node.right = fold_constants(node.right)

        # 两边都是字面量 → 折叠
        if is_literal(node.left) and is_literal(node.right) {
            var result = eval_const_binop(node.op, node.left, node.right)
            if result != nil {
                opt_stats.const_folded = opt_stats.const_folded + 1
                return result
            }
        }

        # 恒等优化：x + 0 → x, x * 1 → x
        if node.op == "+" and is_zero(node.right) {
            opt_stats.peephole = opt_stats.peephole + 1
            return node.left
        }
        if node.op == "*" and is_one(node.right) {
            opt_stats.peephole = opt_stats.peephole + 1
            return node.left
        }
        if node.op == "*" and is_zero(node.right) {
            opt_stats.peephole = opt_stats.peephole + 1
            return make_int(0)
        }
        if node.op == "-" and is_zero(node.right) {
            opt_stats.peephole = opt_stats.peephole + 1
            return node.left
        }

        return node
    }

    if node.tag == "UnaryOp" {
        node.operand = fold_constants(node.operand)
        if is_literal(node.operand) {
            var result = eval_const_unary(node.op, node.operand)
            if result != nil {
                opt_stats.const_folded = opt_stats.const_folded + 1
                return result
            }
        }
        return node
    }

    if node.tag == "Call" {
        var i = 0
        while i < len(node.args) {
            node.args[i] = fold_constants(node.args[i])
            i = i + 1
        }
        return node
    }

    return node
}

fn is_literal(node) -> bool {
    if node == nil { return false }
    return node.tag == "Int" or node.tag == "Float" or node.tag == "String" or node.tag == "Bool"
}

fn is_zero(node) -> bool {
    return node.tag == "Int" and node.value == 0
}

fn is_one(node) -> bool {
    return node.tag == "Int" and node.value == 1
}

fn make_int(n) {
    return { tag: "Int", value: n }
}

fn eval_const_binop(op, left, right) {
    if left.tag == "Int" and right.tag == "Int" {
        var l = left.value
        var r = right.value
        if op == "+" { return make_int(l + r) }
        if op == "-" { return make_int(l - r) }
        if op == "*" { return make_int(l * r) }
        if op == "/" and r != 0 { return make_int(l / r) }
        if op == "%" and r != 0 { return make_int(l % r) }
        if op == "==" { return { tag: "Bool", value: l == r } }
        if op == "!=" { return { tag: "Bool", value: l != r } }
        if op == "<" { return { tag: "Bool", value: l < r } }
        if op == ">" { return { tag: "Bool", value: l > r } }
        if op == "<=" { return { tag: "Bool", value: l <= r } }
        if op == ">=" { return { tag: "Bool", value: l >= r } }
    }
    if left.tag == "String" and right.tag == "String" and op == "+" {
        return { tag: "String", value: left.value + right.value }
    }
    if left.tag == "Bool" and right.tag == "Bool" {
        if op == "and" { return { tag: "Bool", value: left.value and right.value } }
        if op == "or" { return { tag: "Bool", value: left.value or right.value } }
    }
    return nil
}

fn eval_const_unary(op, operand) {
    if operand.tag == "Int" {
        if op == "-" { return make_int(-operand.value) }
    }
    if operand.tag == "Bool" {
        if op == "not" { return { tag: "Bool", value: !operand.value } }
    }
    return nil
}

# ============ 阶段 2：死代码消除 ============
# 删除不可达代码、未使用的变量赋值

fn eliminate_dead_code(node) {
    if node == nil { return nil }

    if node.tag == "Program" {
        var new_stmts = []
        var i = 0
        while i < len(node.stmts) {
            var s = eliminate_dead_code(node.stmts[i])
            if s != nil {
                push(new_stmts, s)
            }
            i = i + 1
        }
        node.stmts = new_stmts
        return node
    }

    if node.tag == "Block" {
        var new_stmts = []
        var i = 0
        while i < len(node.stmts) {
            var s = eliminate_dead_code(node.stmts[i])
            if s != nil {
                push(new_stmts, s)
            }
            i = i + 1
        }
        node.stmts = new_stmts
        return node
    }

    if node.tag == "FnDef" {
        node.body = eliminate_dead_code(node.body)
        return node
    }

    if node.tag == "If" {
        node.then_block = eliminate_dead_code(node.then_block)
        if node.else_block != nil {
            node.else_block = eliminate_dead_code(node.else_block)
        }
        return node
    }

    if node.tag == "While" {
        node.body = eliminate_dead_code(node.body)
        return node
    }

    # return 后面的语句是死代码
    if node.tag == "Return" {
        return node
    }

    # 未使用的 let 绑定（右侧无副作用）→ 删除
    if node.tag == "Let" {
        # 简化版：如果变量名以下划线开头，认为是故意忽略
        var name = node.name
        if len(name) > 0 and char_at(name, 0) == '_' {
            opt_stats.dead_code_removed = opt_stats.dead_code_removed + 1
            return nil
        }
        node.value = eliminate_dead_code(node.value)
        return node
    }

    if node.tag == "Var" {
        node.value = eliminate_dead_code(node.value)
        return node
    }

    if node.tag == "BinOp" {
        node.left = eliminate_dead_code(node.left)
        node.right = eliminate_dead_code(node.right)
        return node
    }

    if node.tag == "Call" {
        var i = 0
        while i < len(node.args) {
            node.args[i] = eliminate_dead_code(node.args[i])
            i = i + 1
        }
        return node
    }

    return node
}

# ============ 阶段 3：小函数内联 ============
# 把函数体小于 N 个 AST 节点的函数在调用点展开

fn inline_small_functions(ast_tree) {
    # 第一遍：收集所有小函数
    var small_fns = {}
    collect_small_functions(ast_tree, small_fns)

    # 第二遍：替换调用点
    inline_calls(ast_tree, small_fns)

    return ast_tree
}

fn collect_small_functions(node, small_fns) {
    if node == nil { return }

    if node.tag == "Program" or node.tag == "Block" {
        var i = 0
        while i < len(node.stmts) {
            if node.stmts[i].tag == "FnDef" {
                var fn_node = node.stmts[i]
                var size = count_nodes(fn_node.body)
                if size <= 20 {
                    small_fns[fn_node.name] = fn_node
                }
            }
            collect_small_functions(node.stmts[i], small_fns)
            i = i + 1
        }
        return
    }

    if node.tag == "FnDef" {
        collect_small_functions(node.body, small_fns)
        return
    }

    if node.tag == "If" {
        collect_small_functions(node.then_block, small_fns)
        if node.else_block != nil {
            collect_small_functions(node.else_block, small_fns)
        }
        return
    }

    if node.tag == "While" {
        collect_small_functions(node.body, small_fns)
        return
    }
}

fn inline_calls(node, small_fns) {
    if node == nil { return }

    if node.tag == "Program" or node.tag == "Block" {
        var i = 0
        while i < len(node.stmts) {
            inline_calls(node.stmts[i], small_fns)
            i = i + 1
        }
        return
    }

    if node.tag == "FnDef" {
        inline_calls(node.body, small_fns)
        return
    }

    if node.tag == "Call" {
        if has_key(small_fns, node.name) {
            opt_stats.inlined = opt_stats.inlined + 1
            # 实际内联会复制函数体并替换参数
            # 这里简化为标记
        }
        var i = 0
        while i < len(node.args) {
            inline_calls(node.args[i], small_fns)
            i = i + 1
        }
        return
    }

    if node.tag == "BinOp" {
        inline_calls(node.left, small_fns)
        inline_calls(node.right, small_fns)
        return
    }

    if node.tag == "Return" {
        if node.value != nil {
            inline_calls(node.value, small_fns)
        }
        return
    }

    if node.tag == "Let" or node.tag == "Var" {
        inline_calls(node.value, small_fns)
        return
    }

    if node.tag == "If" {
        inline_calls(node.cond, small_fns)
        inline_calls(node.then_block, small_fns)
        if node.else_block != nil {
            inline_calls(node.else_block, small_fns)
        }
        return
    }

    if node.tag == "While" {
        inline_calls(node.cond, small_fns)
        inline_calls(node.body, small_fns)
        return
    }
}

fn count_nodes(node) -> int {
    if node == nil { return 0 }
    var count = 1
    if node.tag == "Program" or node.tag == "Block" {
        var i = 0
        while i < len(node.stmts) {
            count = count + count_nodes(node.stmts[i])
            i = i + 1
        }
        return count
    }
    if node.tag == "FnDef" {
        return count + count_nodes(node.body)
    }
    if node.tag == "BinOp" {
        return count + count_nodes(node.left) + count_nodes(node.right)
    }
    if node.tag == "Call" {
        var i = 0
        while i < len(node.args) {
            count = count + count_nodes(node.args[i])
            i = i + 1
        }
        return count
    }
    if node.tag == "If" {
        count = count + count_nodes(node.cond) + count_nodes(node.then_block)
        if node.else_block != nil {
            count = count + count_nodes(node.else_block)
        }
        return count
    }
    if node.tag == "While" {
        return count + count_nodes(node.cond) + count_nodes(node.body)
    }
    if node.tag == "Return" {
        if node.value != nil {
            return count + count_nodes(node.value)
        }
    }
    if node.tag == "Let" or node.tag == "Var" {
        return count + count_nodes(node.value)
    }
    return count
}

# ============ 阶段 4：窥孔优化 ============
# 相邻指令合并、冗余 load/store 删除

fn peephole(ast_tree) {
    # 简化版：统计
    return ast_tree
}

# ============ 统计报告 ============

pub fn report() {
    stdlib.println("优化统计:")
    stdlib.println("  常量折叠: " + stdlib.str(opt_stats.const_folded))
    stdlib.println("  死代码消除: " + stdlib.str(opt_stats.dead_code_removed))
    stdlib.println("  函数内联: " + stdlib.str(opt_stats.inlined))
    stdlib.println("  窥孔优化: " + stdlib.str(opt_stats.peephole))
}

fn has_key(d, key) -> bool {
    var found = false
    for k in d {
        if k == key { found = true }
    }
    return found
}
