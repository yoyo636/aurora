# native_bindings.aur — Aurora C FFI 原生绑定（自举版）
# 对应 Python native_bindings.py
# 用法：
#   extern "C" {
#       fn printf(format: string, ...) -> int
#       fn malloc(size: int) -> *void
#       fn free(ptr: *void)
#   }

import stdlib

# 已加载的动态库
var loaded_libs = {}

# 符号表：函数名 -> 函数指针
var symbol_table = {}

# 类型映射
# Aurora int     ↔ C long
# Aurora float   ↔ C double
# Aurora string  ↔ C char*
# Aurora bool    ↔ C int (0/1)
# Aurora *T      ↔ C T*

# ============ 动态库加载 ============

# 加载系统库
pub fn load_system_lib(name) -> int {
    # FFI: dlopen("lib" + name + ".dylib", RTLD_NOW | RTLD_GLOBAL)
    var handle = sys_dlopen("/usr/lib/lib" + name + ".dylib")
    if handle == 0 {
        handle = sys_dlopen("/usr/lib/lib" + name + ".so")
    }
    loaded_libs[name] = handle
    stdlib.println("加载库: " + name + " (handle=" + stdlib.str(handle) + ")")
    return handle
}

# 加载自定义动态库
pub fn load_lib(path) -> int {
    var handle = sys_dlopen(path)
    if handle == 0 {
        stdlib.println("错误: 无法加载 " + path)
        return 0
    }
    var name = basename(path)
    loaded_libs[name] = handle
    stdlib.println("加载库: " + path)
    return handle
}

# 卸载库
pub fn unload_lib(name) {
    if has_key(loaded_libs, name) {
        sys_dlclose(loaded_libs[name])
        loaded_libs[name] = 0
    }
}

# ============ 符号查找 ============

# 查找函数符号
pub fn find_symbol(lib_handle, name) -> int {
    var sym = sys_dlsym(lib_handle, name)
    if sym == 0 {
        stdlib.println("警告: 找不到符号 " + name)
    }
    return sym
}

# 注册外部函数（编译期会生成调用 stub）
pub fn extern_fn(lib_handle, name, arg_types, ret_type) {
    var sym = find_symbol(lib_handle, name)
    symbol_table[name] = {
        ptr: sym,
        arg_types: arg_types,
        ret_type: ret_type
    }
}

# ============ 常用 C 函数绑定 ============

# 标准库
pub fn bind_stdlib() {
    var libc = load_system_lib("c")

    # malloc / free / realloc
    extern_fn(libc, "malloc", ["int"], "*void")
    extern_fn(libc, "free", ["*void"], "void")
    extern_fn(libc, "realloc", ["*void", "int"], "*void")
    extern_fn(libc, "memcpy", ["*void", "*void", "int"], "*void")
    extern_fn(libc, "memset", ["*void", "int", "int"], "*void")

    # IO
    extern_fn(libc, "printf", ["string", "..."], "int")
    extern_fn(libc, "fprintf", ["*void", "string", "..."], "int")
    extern_fn(libc, "scanf", ["string", "..."], "int")

    # 字符串
    extern_fn(libc, "strlen", ["string"], "int")
    extern_fn(libc, "strcpy", ["string", "string"], "string")
    extern_fn(libc, "strcmp", ["string", "string"], "int")

    # 数学
    extern_fn(libc, "sqrt", ["float"], "float")
    extern_fn(libc, "sin", ["float"], "float")
    extern_fn(libc, "cos", ["float"], "float")
    extern_fn(libc, "pow", ["float", "float"], "float")
    extern_fn(libc, "log", ["float"], "float")
    extern_fn(libc, "exp", ["float"], "float")

    stdlib.println("✓ libc 绑定完成")
}

# 系统调用
pub fn bind_unistd() {
    var libc = load_system_lib("c")

    # unistd.h
    extern_fn(libc, "read", ["int", "*void", "int"], "int")
    extern_fn(libc, "write", ["int", "*void", "int"], "int")
    extern_fn(libc, "open", ["string", "int", "int"], "int")
    extern_fn(libc, "close", ["int"], "int")
    extern_fn(libc, "fork", [], "int")
    extern_fn(libc, "execve", ["string", "*void", "*void"], "int")
    extern_fn(libc, "exit", ["int"], "void")
    extern_fn(libc, "getpid", [], "int")
    extern_fn(libc, "sleep", ["int"], "int")

    stdlib.println("✓ unistd 绑定完成")
}

