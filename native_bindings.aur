fn sizeof_type(t) -> int {
    if t == "int" { return 8 }
    if t == "float" { return 8 }
    if t == "string" { return 8 }
    if t == "*void" { return 8 }
    if t == "bool" { return 4 }
    return 8
}

fn basename(path) -> string {
    var result = ""
    var i = 0
    while i < len(path) {
        var c = char_at(path, i)
        if c == '/' {
            result = ""
        } else {
            result = result + c
        }
        i = i + 1
    }
    return result
}

fn has_key(d, key) -> bool {
    var found = false
    for k in d {
        if k == key { found = true }
    }
    return found
}
