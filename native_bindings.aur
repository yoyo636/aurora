# ============ 结构体绑定 ============

# 定义 C 结构体
pub fn bind_struct(name, fields) {
    var offsets = {}
    var offset = 0
    for field_name in fields {
        var field_type = fields[field_name]
        offsets[field_name] = offset
        offset = offset + sizeof_type(field_type)
    }
    symbol_table["struct_" + name] = offsets
    return offsets
}

# 读取结构体字段
pub fn read_field(struct_ptr, struct_name, field_name) -> int {
    var offsets = symbol_table["struct_" + struct_name]
    var offset = offsets[field_name]
    return sys_read_mem(struct_ptr + offset)
}

# 写入结构体字段
pub fn write_field(struct_ptr, struct_name, field_name, value) {
    var offsets = symbol_table["struct_" + struct_name]
    var offset = offsets[field_name]
    sys_write_mem(struct_ptr + offset, value)
}

# ============ 内存操作 ============

# 分配内存
pub fn c_malloc(size) -> int {
    return sys_call_func(symbol_table["malloc"].ptr, [size])
}

# 释放内存
pub fn c_free(ptr) {
    sys_call_func(symbol_table["free"].ptr, [ptr])
}

# 复制内存
pub fn c_memcpy(dst, src, size) {
    sys_call_func(symbol_table["memcpy"].ptr, [dst, src, size])
}

# ============ 错误处理 ============

# 获取上次错误（errno）
pub fn get_errno() -> int {
    return sys_get_errno()
}

# 清除错误
pub fn clear_errno() {
    sys_set_errno(0)
}

# ============ 统计 ============

pub fn stats() {
    stdlib.println("FFI 统计:")
    stdlib.println("  已加载库: " + stdlib.str(len(loaded_libs)))
    stdlib.println("  已注册符号: " + stdlib.str(len(symbol_table)))
}

