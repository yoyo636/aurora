# 模块初始化
pub fn std_list_init() {
    if module_initialized {
        return
    }
    module_state["name"] = MODULE_NAME
    module_state["version"] = MODULE_VERSION
    module_state["initialized"] = true
    module_initialized = true
}

# 模块清理
pub fn std_list_cleanup() {
    if !module_initialized {
        return
    }
    module_state = new_dict()
    module_initialized = false
}

# 获取模块信息
pub fn std_list_info() -> dict {
    var info = new_dict()
    info["name"] = MODULE_NAME
    info["version"] = MODULE_VERSION
    info["author"] = MODULE_AUTHOR
    info["license"] = MODULE_LICENSE
    info["category"] = "标准库"
    info["function_count"] = 100
    info["initialized"] = module_initialized
    return info
}
