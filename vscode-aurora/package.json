{
  "name": "aurora-ide",
  "displayName": "Aurora Language (v5.0.0)",
  "description": "Aurora 编程语言支持 v5.0.0: 284万行自举标准库、ARM64 原生机器码、AOT 编译、原生 VM、语法高亮、一键运行、静态检查、LSP、格式化、性能分析、调试、包管理、AI 引擎、全栈开发、增量计算、语言级响应式",
  "version": "5.0.0",
  "publisher": "aurora",
  "license": "MIT",
  "icon": "icons/aurora.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "aurora",
    "language",
    "programming",
    "incremental",
    "reactive",
    "dataflow",
    "ai",
    "machine learning",
    "systems",
    "native",
    "aot",
    "bootstrap"
  ],
  "activationEvents": [
    "onLanguage:aurora",
    "onCommand:aurora.run",
    "onCommand:aurora.compile",
    "onCommand:aurora.check",
    "onCommand:aurora.runSelection",
    "onCommand:aurora.fmt",
    "onCommand:aurora.profile",
    "onCommand:aurora.debug",
    "onCommand:aurora.lsp",
    "onCommand:aurora.pkg",
    "onCommand:aurora.ai",
    "onCommand:aurora.bench",
    "onCommand:aurora.workspace",
    "onCommand:aurora.deps",
    "onCommand:aurora.ui",
    "onCommand:aurora.package",
    "onCommand:aurora.kernel",
    "onCommand:aurora.serve",
    "onCommand:aurora.interop",
    "onCommand:aurora.wasm",
    "onCommand:aurora.new",
    "onCommand:aurora.generate",
    "onCommand:aurora.db",
    "onCommand:aurora.dev",
    "onCommand:aurora.deploy",
    "onCommand:aurora.webapp",
    "onCommand:aurora.showDependencyGraph",
    "onCommand:aurora.toggleIncrementalDebug",
    "onCommand:aurora.test",
    "onCommand:aurora.doc",
    "onCommand:aurora.refactor",
    "onCommand:aurora.renameSymbol"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "aurora",
        "aliases": [
          "Aurora",
          "aurora"
        ],
        "extensions": [
          ".aur"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aurora",
        "scopeName": "source.aurora",
        "path": "./syntaxes/aurora.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Aurora Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/aurora-dark.json"
      },
      {
        "label": "Aurora Light",
        "uiTheme": "vs",
        "path": "./themes/aurora-light.json"
      }
    ],
    "snippets": [
      {
        "language": "aurora",
        "path": "./snippets/aurora.json"
      }
    ],
    "commands": [
      {
        "command": "aurora.run",
        "title": "Aurora: 运行当前文件 (VM)",
        "icon": "$(play)"
      },
      {
        "command": "aurora.compile",
        "title": "Aurora: 编译为原生机器码 (AOT)",
        "icon": "$(tools)"
      },
      {
        "command": "aurora.check",
        "title": "Aurora: 静态检查当前文件",
        "icon": "$(check-all)"
      },
      {
        "command": "aurora.runSelection",
        "title": "Aurora: 运行选中代码"
      },
      {
        "command": "aurora.fmt",
        "title": "Aurora: 格式化当前文件",
        "icon": "$(wand)"
      },
      {
        "command": "aurora.profile",
        "title": "Aurora: 性能分析当前文件",
        "icon": "$(dashboard)"
      },
      {
        "command": "aurora.debug",
        "title": "Aurora: 调试当前文件",
        "icon": "$(debug-alt)"
      },
      {
        "command": "aurora.lsp",
        "title": "Aurora: 启动 LSP 语言服务器",
        "icon": "$(server)"
      },
      {
        "command": "aurora.pkg",
        "title": "Aurora: 包管理",
        "icon": "$(package)"
      },
      {
        "command": "aurora.ai",
        "title": "Aurora: AI 训练/推理",
        "icon": "$(zap)"
      },
      {
        "command": "aurora.bench",
        "title": "Aurora: 性能基准测试",
        "icon": "$(gauge)"
      },
      {
        "command": "aurora.test",
        "title": "Aurora: 运行测试",
        "icon": "$(beaker)"
      },
      {
        "command": "aurora.doc",
        "title": "Aurora: 生成文档",
        "icon": "$(book)"
      },
      {
        "command": "aurora.refactor",
        "title": "Aurora: 重构代码",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "aurora.renameSymbol",
        "title": "Aurora: 重命名符号",
        "icon": "$(edit)"
      },
      {
        "command": "aurora.workspace",
        "title": "Aurora: 工作区管理"
      },
      {
        "command": "aurora.deps",
        "title": "Aurora: 依赖管理"
      },
      {
        "command": "aurora.ui",
        "title": "Aurora: 运行 GUI 应用",
        "icon": "$(window)"
      },
      {
        "command": "aurora.package",
        "title": "Aurora: 跨平台打包",
        "icon": "$(package)"
      },
      {
        "command": "aurora.kernel",
        "title": "Aurora: 安装 Jupyter 内核"
      },
      {
        "command": "aurora.serve",
        "title": "Aurora: 启动推理服务",
        "icon": "$(rocket)"
      },
      {
        "command": "aurora.interop",
        "title": "Aurora: 语言互操作"
      },
      {
        "command": "aurora.wasm",
        "title": "Aurora: 编译 WebAssembly",
        "icon": "$(cloud)"
      },
      {
        "command": "aurora.new",
        "title": "Aurora: 创建项目",
        "icon": "$(add)"
      },
      {
        "command": "aurora.generate",
        "title": "Aurora: 代码生成",
        "icon": "$(gear)"
      },
      {
        "command": "aurora.db",
        "title": "Aurora: 数据库管理",
        "icon": "$(database)"
      },
      {
        "command": "aurora.dev",
        "title": "Aurora: 开发模式",
        "icon": "$(debug-start)"
      },
      {
        "command": "aurora.deploy",
        "title": "Aurora: 部署",
        "icon": "$(rocket)"
      },
      {
        "command": "aurora.webapp",
        "title": "Aurora: Web应用脚手架",
        "icon": "$(globe)"
      },
      {
        "command": "aurora.showDependencyGraph",
        "title": "Aurora: 显示增量计算依赖图",
        "icon": "$(git-branch)"
      },
      {
        "command": "aurora.toggleIncrementalDebug",
        "title": "Aurora: 切换增量调试模式",
        "icon": "$(bug)"
      }
    ],
    "keybindings": [
      {
        "command": "aurora.run",
        "key": "cmd+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == aurora && editorTextFocus"
      },
      {
        "command": "aurora.run",
        "key": "ctrl+alt+r",
        "when": "editorLangId == aurora && editorTextFocus && !isMac"
      },
      {
        "command": "aurora.compile",
        "key": "cmd+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == aurora && editorTextFocus"
      },
      {
        "command": "aurora.compile",
        "key": "ctrl+alt+b",
        "when": "editorLangId == aurora && editorTextFocus && !isMac"
      },
      {
        "command": "aurora.check",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorLangId == aurora && editorTextFocus"
      },
      {
        "command": "aurora.check",
        "key": "ctrl+alt+k",
        "when": "editorLangId == aurora && editorTextFocus && !isMac"
      },
      {
        "command": "aurora.fmt",
        "key": "cmd+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorLangId == aurora && editorTextFocus"
      },
      {
        "command": "aurora.fmt",
        "key": "ctrl+alt+f",
        "when": "editorLangId == aurora && editorTextFocus && !isMac"
      },
      {
        "command": "aurora.test",
        "key": "cmd+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorLangId == aurora && editorTextFocus"
      },
      {
        "command": "aurora.test",
        "key": "ctrl+alt+t",
        "when": "editorLangId == aurora && editorTextFocus && !isMac"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "aurora.run",
          "when": "editorLangId == aurora",
          "group": "navigation@1"
        },
        {
          "command": "aurora.compile",
          "when": "editorLangId == aurora",
          "group": "navigation@2"
        },
        {
          "command": "aurora.check",
          "when": "editorLangId == aurora",
          "group": "navigation@3"
        },
        {
          "command": "aurora.fmt",
          "when": "editorLangId == aurora",
          "group": "navigation@4"
        },
        {
          "command": "aurora.test",
          "when": "editorLangId == aurora",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "command": "aurora.run",
          "when": "editorLangId == aurora",
          "group": "aurora@1"
        },
        {
          "command": "aurora.compile",
          "when": "editorLangId == aurora",
          "group": "aurora@2"
        },
        {
          "command": "aurora.runSelection",
          "when": "editorLangId == aurora && editorHasSelection",
          "group": "aurora@3"
        },
        {
          "command": "aurora.check",
          "when": "editorLangId == aurora",
          "group": "aurora@4"
        },
        {
          "command": "aurora.fmt",
          "when": "editorLangId == aurora",
          "group": "aurora@5"
        },
        {
          "command": "aurora.profile",
          "when": "editorLangId == aurora",
          "group": "aurora@6"
        },
        {
          "command": "aurora.debug",
          "when": "editorLangId == aurora",
          "group": "aurora@7"
        },
        {
          "command": "aurora.test",
          "when": "editorLangId == aurora",
          "group": "aurora@8"
        },
        {
          "command": "aurora.refactor",
          "when": "editorLangId == aurora",
          "group": "aurora@9"
        },
        {
          "command": "aurora.renameSymbol",
          "when": "editorLangId == aurora",
          "group": "aurora@10"
        },
        {
          "command": "aurora.pkg",
          "when": "editorLangId == aurora",
          "group": "aurora@11"
        },
        {
          "command": "aurora.ai",
          "when": "editorLangId == aurora",
          "group": "aurora@12"
        },
        {
          "command": "aurora.bench",
          "when": "editorLangId == aurora",
          "group": "aurora@13"
        },
        {
          "command": "aurora.ui",
          "when": "editorLangId == aurora",
          "group": "aurora@14"
        },
        {
          "command": "aurora.new",
          "when": "editorLangId == aurora",
          "group": "aurora@15"
        },
        {
          "command": "aurora.generate",
          "when": "editorLangId == aurora",
          "group": "aurora@16"
        },
        {
          "command": "aurora.db",
          "when": "editorLangId == aurora",
          "group": "aurora@17"
        },
        {
          "command": "aurora.dev",
          "when": "editorLangId == aurora",
          "group": "aurora@18"
        },
        {
          "command": "aurora.deploy",
          "when": "editorLangId == aurora",
          "group": "aurora@19"
        },
        {
          "command": "aurora.webapp",
          "when": "editorLangId == aurora",
          "group": "aurora@20"
        }
      ]
    },
    "configuration": {
      "title": "Aurora",
      "properties": {
        "aurora.auroraDir": {
          "type": "string",
          "default": "/Users/wuyuanduo/aurora",
          "description": "Aurora 语言项目根目录"
        },
        "aurora.mode": {
          "type": "string",
          "default": "vm",
          "enum": ["vm", "aot"],
          "description": "运行模式: vm=原生虚拟机, aot=AOT 编译为原生机器码"
        },
        "aurora.optimizationLevel": {
          "type": "string",
          "default": "O2",
          "enum": ["O0", "O1", "O2", "O3"],
          "description": "优化级别"
        },
        "aurora.incrementalComputation": {
          "type": "boolean",
          "default": true,
          "description": "启用语言级增量计算"
        },
        "aurora.lspEnabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 LSP 语言服务器"
        },
        "aurora.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存时自动格式化"
        },
        "aurora.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存时自动静态检查"
        },
        "aurora.showDependencyGraph": {
          "type": "boolean",
          "default": false,
          "description": "显示增量计算依赖图"
        }
      }
    }
  }
}
