{
  "name": "Aurora",
  "scopeName": "source.aurora",
  "fileTypes": ["aur"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#destructuring" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#cliCommands" },
    { "include": "#modules" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.aurora" },
        { "match": "#.*$", "name": "comment.line.hash.aurora" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "(r|R)(\")",
          "beginCaptures": {
            "1": { "name": "string.quoted.raw.aurora" },
            "2": { "name": "punctuation.definition.string.begin.aurora" }
          },
          "end": "\"",
          "name": "string.quoted.raw.aurora"
        },
        {
          "begin": "(r|R)(')",
          "beginCaptures": {
            "1": { "name": "string.quoted.raw.aurora" },
            "2": { "name": "punctuation.definition.string.begin.aurora" }
          },
          "end": "'",
          "name": "string.quoted.raw.aurora"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.aurora",
          "patterns": [
            { "match": "\\\\[\"\\\\nrt0]", "name": "constant.character.escape.aurora" },
            { "match": "\\{[^}]*\\}", "name": "string.interpolated.aurora" }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.aurora"
        }
      ]
    },
    "keywords": {
      "match": "\\b(fn|let|var|const|if|elif|else|for|while|return|type|enum|impl|match|trait|true|false|nil|in|break|continue|import|from|as|spawn|chan|select|default|try|catch|finally|panic|self|std|and|or|not|loop|pub|mut|defer|yield|async|await|unsafe|extern|cfg|tensor|struct|source|live|transact)\\b",
      "name": "keyword.control.aurora"
    },
    "destructuring": {
      "begin": "\\b(let|var|const)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.aurora" },
        "2": { "name": "punctuation.destructuring.begin.aurora" }
      },
      "end": "\\}(?=\\s*=)",
      "endCaptures": {
        "0": { "name": "punctuation.destructuring.end.aurora" }
      },
      "patterns": [
        { "include": "#strings" },
        { "match": "\\.\\.\\.", "name": "keyword.operator.spread.aurora" },
        { "match": "\\b([A-Za-z_]\\w*)\\b\\s*(:)", "captures": {
          "1": { "name": "variable.other.destructured.aurora" },
          "2": { "name": "punctuation.separator.aurora" }
        } },
        { "match": "\\b([A-Za-z_]\\w*)\\b\\s*(=)", "captures": {
          "1": { "name": "variable.other.destructured.aurora" },
          "2": { "name": "keyword.operator.assignment.aurora" }
        } },
        { "match": ",", "name": "punctuation.separator.aurora" }
      ],
      "name": "meta.destructuring.aurora"
    },
    "cliCommands": {
      "match": "\\b(new|generate|db|dev|deploy|webapp)\\b",
      "name": "keyword.other.cli.aurora"
    },
    "modules": {
      "match": "\\bstd\\.(web|db|cli|tui|git)\\b",
      "name": "support.module.aurora"
    },
    "annotations": {
      "patterns": [
        {
          "begin": "#\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.annotation.aurora" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.annotation.aurora" }
          },
          "patterns": [
            { "match": "\\b(cfg|target_os|target_arch|target_env|feature|test|derive|inline|repr|deprecated|allow|warn|deny|forbid)\\b", "name": "storage.modifier.annotation.aurora" },
            { "match": "\"[^\"]*\"", "name": "string.quoted.double.aurora" },
            { "match": "[(),=]", "name": "punctuation.separator.annotation.aurora" }
          ],
          "name": "meta.annotation.aurora"
        },
        {
          "begin": "(@perf)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "storage.modifier.annotation.aurora" }
          },
          "end": "\\)",
          "patterns": [
            { "match": "\\b(critical|hot|cold|size|trace)\\b", "name": "variable.parameter.annotation.aurora" },
            { "match": ",", "name": "punctuation.separator.annotation.aurora" }
          ],
          "name": "meta.annotation.aurora"
        },
        {
          "match": "@\\w+",
          "name": "storage.modifier.annotation.aurora"
        }
      ]
    },
    "builtins": {
      "match": "\\b(println|print|read_int|read_line|read_float|input|range|len|str|int|float|bool|type|assert|sleep|abs|min|max|sqrt|pow|floor|ceil|round|sin|cos|log|random|push|pop|map|filter|reduce|contains|sort|keys|clone|join|split|upper|lower|trim|exists|panic|Result|Ok|Err)\\b",
      "name": "support.function.builtin.aurora"
    },
    "numbers": {
      "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.aurora"
    },
    "operators": {
      "patterns": [
        { "match": "&&|\\|\\||<<|>>|<=|>=|==|!=|\\+=|-=|\\*=|/=|\\*\\*|->|=>|<-|\\?\\?|\\?\\.|\\|>|\\.\\.\\.|\\.\\.", "name": "keyword.operator.aurora" },
        { "match": "\\?(?![?.])", "name": "keyword.operator.aurora" },
        { "match": "[+\\-*/%<>=!&|^~]", "name": "keyword.operator.aurora" }
      ]
    }
  }
}
