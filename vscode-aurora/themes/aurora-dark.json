    "terminal.ansiBrightBlue": "#91d5ff",
    "terminal.ansiBrightMagenta": "#e599f7",
    "terminal.ansiBrightCyan": "#8ce99a",
    "terminal.ansiBrightWhite": "#ffffff",
    "input.background": "#0a0a0a",
    "input.foreground": "#e8e8e8",
    "input.border": "#222222",
    "inputOption.activeBorder": "#ffffff",
    "dropdown.background": "#0a0a0a",
    "dropdown.foreground": "#e8e8e8",
    "dropdown.border": "#222222",
    "list.activeSelectionBackground": "#111111",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#0a0a0a",
