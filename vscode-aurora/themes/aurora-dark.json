    "panelTitle.activeBorder": "#ffffff",
    "panelTitle.activeForeground": "#ffffff",
    "panelTitle.inactiveForeground": "#555555",
    "terminal.background": "#000000",
    "terminal.foreground": "#e8e8e8",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#ff6b6b",
    "terminal.ansiGreen": "#51cf66",
    "terminal.ansiYellow": "#ffd43b",
    "terminal.ansiBlue": "#74c0fc",
    "terminal.ansiMagenta": "#da77f2",
    "terminal.ansiCyan": "#66d9e8",
    "terminal.ansiWhite": "#e8e8e8",
    "terminal.ansiBrightBlack": "#555555",
    "terminal.ansiBrightRed": "#ff8787",
