// isoceles_tests.aur — 等腰判断函数的自动化测试
// 无需输入,直接运行: ./aurora-run run examples/triangles/isoceles_tests.aur
// 覆盖:等腰、等边、普通三角形、不能构成三角形、退化情形、小数边长

fn is_isoceles(a, b, c) -> bool {
    if a + b <= c || a + c <= b || b + c <= a {
        return false
    }
    a == b || b == c || a == c
}

fn run_case(name, a, b, c, expect) {
    let got = is_isoceles(a, b, c)
    if got == expect {
        println("✓ {name}:期望 {expect} 得到 {got}")
    } else {
        println("✗ {name}:期望 {expect} 得到 {got} —— 失败!")
    }
}

println("=== 等腰判断自动化测试 ===")

// 等腰:AB == AC,顶角在 A
run_case("AB=AC 等腰(5,5,8)", 5, 5, 8, true)
// 等腰:AB == BC,顶角在 B
run_case("AB=BC 等腰(6,6,4)", 6, 6, 4, true)
// 等边三角形:三条边相等,同时满足等腰定义
run_case("等边(6,6,6)", 6, 6, 6, true)
// 等腰:AC == BC,顶角在 C
run_case("AC=BC 等腰(4,7,4)", 4, 7, 4, true)
// 普通三角形:三边互不相等
run_case("不等边(3,4,5)", 3, 4, 5, false)
// 不能构成三角形:两边之和小于第三边
run_case("不构成(1,1,3)", 1, 1, 3, false)
// 退化情形:两边之和恰好等于第三边
run_case("退化(2,2,4)", 2, 2, 4, false)
// 小数边长
run_case("小数等腰(2.5,2.5,3)", 2.5, 2.5, 3, true)
// 零与负数(无效输入不判定为等腰)
run_case("含0(0,1,1)", 0, 1, 1, false)
run_case("含负数(-1,2,2)", -1, 2, 2, false)

println("=== 测试完成 ===")
