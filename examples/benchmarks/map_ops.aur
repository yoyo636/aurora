// 基准测试:Map 操作
import std.time

fn main() {
    let N = 100000
    let start = std.time.now()
    let m = {}
    for i in range(N) {
        m["key_" + str(i)] = i
    }
    var sum = 0
    for i in range(N) {
        sum = sum + m["key_" + str(i)]
    }
    let elapsed = std.time.now() - start
    println("Map 写入+读取 N=" + str(N) + " sum=" + str(sum))
    println("耗时: " + str(elapsed) + "ms")
}

main()
