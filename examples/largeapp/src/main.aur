# 大型项目示例 — 任务管理系统(Todo CLI)
# 分层架构:models / services / utils / storage
# 展示 Aurora 的多文件模块系统、标准库、可编译可运行

import services.task_service
import utils.format

fn main() {
    println(utils.format.format_header("Aurora 任务管理系统 v1.0"))
    println("")

    # 初始化服务(数据持久化到 tasks.json)
    let svc = services.task_service.new_service("tasks.json")

    # 添加一些示例任务
    services.task_service.add(svc, "完成 Aurora 编译器", "high")
    services.task_service.add(svc, "写文档", "medium")
    services.task_service.add(svc, "写测试", "high")
    services.task_service.add(svc, "休息一下", "low")

    # 标记任务 #1 完成
    services.task_service.complete(svc, 1)

    # 显示所有任务
    println("=== 所有任务 ===")
    println(services.task_service.render(svc))
    println("")

    # 显示统计
    println("=== 统计 ===")
    println(services.task_service.stats(svc))
    println("")

    # 显示待办任务
    println("=== 待办任务 ===")
    let pending = services.task_service.list_pending(svc)
    println(utils.format.format_task_list(pending))
    println("")

    # 显示高优先级任务
    println("=== 高优先级任务 ===")
    let high = services.task_service.list_by_priority(svc, "high")
    println(utils.format.format_task_list(high))
    println("")

    # 删除任务 #2
    services.task_service.remove(svc, 2)
    println("=== 删除 #2 后 ===")
    println(services.task_service.render(svc))
    println(services.task_service.stats(svc))

    println("")
    println("数据已保存到 tasks.json")
}

main()
