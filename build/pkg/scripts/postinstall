#!/bin/bash
# Aurora 安装后脚本:自动配置一切
# 以 root 权限运行

set -e

AURORA_HOME="/usr/local/lib/aurora"
BIN_PATH="/usr/local/bin/aurora"

# ── 1. 获取当前登录用户 ──
CONSOLE_USER=$(stat -f '%Su' /dev/console 2>/dev/null || echo "")
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
    CONSOLE_USER=$(who | grep console | awk '{print $1}' | head -1)
fi
USER_HOME=$(eval echo "~$CONSOLE_USER" 2>/dev/null || echo "/Users/$CONSOLE_USER")

echo "=== Aurora 安装后配置 ==="
echo "运行时: $AURORA_HOME"
echo "命令:   $BIN_PATH"
echo "用户:   $CONSOLE_USER ($USER_HOME)"

# ── 2. 设置权限 ──
chmod +x "$BIN_PATH"
chmod -R a+rX "$AURORA_HOME"

# ── 3. 配置环境变量(/etc/paths.d) ──
if [ -d /etc/paths.d ]; then
    echo "/usr/local/bin" > /etc/paths.d/aurora
    chmod 644 /etc/paths.d/aurora
    echo "✓ 环境变量已配置(/etc/paths.d/aurora)"
fi

# ── 4. 自动安装 VSCode 插件 ──
VSIX_FILE=$(ls "$AURORA_HOME"/vscode-extension/*.vsix 2>/dev/null | head -1)
if [ -n "$VSIX_FILE" ] && [ -d "$USER_HOME/.vscode" ]; then
    EXT_DIR="$USER_HOME/.vscode/extensions"
    mkdir -p "$EXT_DIR"

    # 从 .vsix 中读取插件 ID 和版本
    PLUGIN_INFO=$(unzip -p "$VSIX_FILE" extension/package.json 2>/dev/null | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('publisher','aurora') + '.' + d.get('name','aurora') + '-' + d.get('version','0.0.1'))
except:
    print('aurora.aurora-0.0.1')
" 2>/dev/null || echo "aurora.aurora-0.0.1")

    TARGET_DIR="$EXT_DIR/$PLUGIN_INFO"

    # 移除旧版本
    rm -rf "$EXT_DIR"/aurora.aurora-* 2>/dev/null || true

    # 解压插件
    mkdir -p "$TARGET_DIR"
    unzip -q -o "$VSIX_FILE" -d /tmp/aurora-vsix-$$ 2>/dev/null
    if [ -d /tmp/aurora-vsix-$$/extension ]; then
        cp -R /tmp/aurora-vsix-$$/extension/* "$TARGET_DIR/"
    fi
    rm -rf /tmp/aurora-vsix-$$

    # 设置所有者
    chown -R "$CONSOLE_USER" "$EXT_DIR" 2>/dev/null || true

    echo "✓ VSCode 插件已安装: $PLUGIN_INFO"
elif [ -n "$VSIX_FILE" ]; then
    echo "ℹ VSCode 未安装,插件已保存到 $AURORA_HOME/vscode-extension/"
    echo "  可手动在 VSCode 中安装: code --install-extension $VSIX_FILE"
fi

# ── 5. 验证 Python3 ──
if command -v python3 &> /dev/null; then
    PY_VER=$(python3 --version 2>&1)
    echo "✓ Python: $PY_VER"
else
    echo "⚠ 未找到 python3,请安装 Python 3.8+: brew install python"
fi

# ── 6. 验证 Aurora 安装 ──
if [ -x "$BIN_PATH" ]; then
    AURORA_VER=$("$BIN_PATH" --version 2>&1 || echo "unknown")
    echo "✓ Aurora: $AURORA_VER"
else
    echo "✗ Aurora 命令不可用"
fi

# ── 7. 安装摘要文件 ──
cat > "$AURORA_HOME/INSTALL_INFO.txt" <<EOF
Aurora 编程语言 — 安装信息
================================
版本: $(cat "$AURORA_HOME/__init__.py" | grep __version__ | cut -d'"' -f2 2>/dev/null || echo "1.3.0")
安装时间: $(date)
安装用户: $CONSOLE_USER
运行时: $AURORA_HOME
命令: $BIN_PATH
VSCode 插件: ${VSIX_FILE:-未安装}
AI 文档: $AURORA_HOME/docs/AI_GUIDE.md
         $AURORA_HOME/docs/AI_SYSTEM_PROMPT.md

快速开始:
  aurora --version
  aurora new myapp && cd myapp && aurora run
  aurora build    # AOT 编译
  aurora watch    # 文件变化自动运行
  aurora test     # 运行测试
EOF

echo ""
echo "=== 安装完成 ==="
echo "  运行时: $AURORA_HOME"
echo "  命令:   $BIN_PATH"
echo "  AI 文档: $AURORA_HOME/docs/"
echo "  示例:   $AURORA_HOME/examples/"
echo ""
echo "快速开始: aurora new hello && cd hello && aurora run"

exit 0
