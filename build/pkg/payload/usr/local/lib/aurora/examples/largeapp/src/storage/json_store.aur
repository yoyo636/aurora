# JSON 持久化存储 — 负责数据的读写,与业务逻辑分离

import std.json
import std.io

fn load(path) {
    if not std.io.exists(path) {
        return []
    }
    let content = std.io.read_file(path)
    if content == "" {
        return []
    }
    return std.json.parse(content)
}

fn save(path, tasks) {
    let content = std.json.stringify(tasks)
    std.io.write_file(path, content)
    return tasks.len()
}
