# 任务服务 — 业务逻辑层,协调模型、存储、工具
# 大型项目的核心:服务层封装所有业务规则

import models.task
import storage.json_store
import utils.format

fn new_service(data_path) {
    return {
        "tasks": storage.json_store.load(data_path),
        "data_path": data_path,
        "next_id": 1,
    }
}

fn _persist(svc) {
    storage.json_store.save(svc["data_path"], svc["tasks"])
}

fn add(svc, title, priority) {
    let task = models.task.new_task(svc["next_id"], title, priority)
    svc["next_id"] = svc["next_id"] + 1
    svc["tasks"].push(task)
    _persist(svc)
    return task
}

fn complete(svc, task_id) {
    for t in svc["tasks"] {
        if t["id"] == task_id {
            models.task.toggle(t)
            _persist(svc)
            return t
        }
    }
    return nil
}

fn remove(svc, task_id) {
    let kept = []
    var removed = nil
    for t in svc["tasks"] {
        if t["id"] == task_id {
            removed = t
        } else {
            kept.push(t)
        }
    }
    svc["tasks"] = kept
    _persist(svc)
    return removed
}

fn list_all(svc) {
    return svc["tasks"]
}

fn list_pending(svc) {
    let result = []
    for t in svc["tasks"] {
        if not t["done"] {
            result.push(t)
        }
    }
    return result
}

fn list_by_priority(svc, priority) {
    let result = []
    for t in svc["tasks"] {
        if t["priority"] == priority {
            result.push(t)
        }
    }
    return result
}

fn stats(svc) {
    return utils.format.format_stats(svc["tasks"])
}

fn render(svc) {
    return utils.format.format_task_list(svc["tasks"])
}
