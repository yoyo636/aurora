<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Aurora 编程语言</title>
    <background file="background.png" alignment="bottomleft" scaling="proportional"/>
    <background-darkAqua file="background-dark.png" alignment="bottomleft" scaling="proportional"/>

    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>

    <!-- 欢迎页面 -->
    <welcome file="welcome.html" mime-type="text/html"/>

    <!-- 介绍页面 -->
    <readme file="readme.html" mime-type="text/html"/>

    <!-- 许可协议 -->
    <license file="license.html" mime-type="text/html"/>

    <!-- 安装完成页面 -->
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="default">
            <line choice="aurora-core"/>
        </line>
    </choices-outline>

    <choice id="default" visible="false">
        <pkg-ref id="com.aurora-lang.core"/>
    </choice>

    <choice id="aurora-core" visible="false" title="Aurora 核心运行时" description="Aurora 解释器、编译器、标准库与 CLI 工具">
        <pkg-ref id="com.aurora-lang.core"/>
    </choice>

    <pkg-ref id="com.aurora-lang.core" version="3.1.0" onConclusion="none">aurora-core.pkg</pkg-ref>
</installer-gui-script>
