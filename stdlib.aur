# stdlib.aur — Aurora 标准库（自举版）
# 替代 Python stdlib.py

# ---- 打印函数 ----
pub fn print(s) {
    # 简化版：调用系统调用
    # 在完整实现中，这里会调用 write(1, s, len(s))
}

pub fn println(s) {
    print(s)
    print("\n")
}

# ---- 类型转换 ----
pub fn str(n) {
    # 简化版：整数转字符串
    if n == 0 { return "0" }
    var neg = false
    var v = n
    if v < 0 { neg = true; v = -v }
    var result = ""
    while v > 0 {
        var d = v % 10
        result = chr(48 + d) + result
        v = v / 10
    }
    if neg { result = "-" + result }
    return result
}

pub fn int(s) {
    # 简化版：字符串转整数
    var result = 0
    var neg = false
    var i = 0
    if len(s) > 0 {
        if char_at(s, 0) == '-' { neg = true; i = 1 }
    }
    while i < len(s) {
        var c = char_at(s, i)
        var d = ord(c) - 48
        result = result * 10 + d
        i = i + 1
    }
    if neg { result = -result }
    return result
}

# ---- 字符串操作 ----
pub fn len(s) {
    var count = 0
    var i = 0
    while i < len(s) { count = count + 1; i = i + 1 }
    return count
}

pub fn char_at(s, i) {
    # 简化版：返回字符串第 i 个字符
    return s[i]
}

pub fn ord(c) {
    # 简化版：字符转 ASCII
    return int(c)
}

pub fn chr(n) {
    # 简化版：ASCII 转字符
    return str(n)
}

# ---- 数学函数 ----
pub fn abs(n) {
    if n < 0 { return -n }
    return n
}

pub fn min(a, b) {
    if a < b { return a }
    return b
}

pub fn max(a, b) {
    if a > b { return a }
    return b
}

pub fn pow(base, exp) {
    var result = 1
    var i = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}

pub fn sqrt(n) {
    # 简化版：牛顿迭代法
    if n < 0 { return 0 }
    if n == 0 { return 0 }
    var x = n / 2
    var i = 0
    while i < 20 {
        x = (x + n / x) / 2
        i = i + 1
    }
    return x
}

# ---- 列表操作 ----
pub fn push(arr, item) {
    arr[len(arr)] = item
}

pub fn pop(arr) {
    var last = arr[len(arr) - 1]
    arr[len(arr) - 1] = 0
    return last
}

pub fn range(start, end) {
    var arr = []
    var i = start
    while i < end {
        push(arr, i)
        i = i + 1
    }
    return arr
}

